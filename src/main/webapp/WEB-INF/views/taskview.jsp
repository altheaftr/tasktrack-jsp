<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><%@ include file="_head.jspf" %><div class="container pb-5 fade-up"><%@ include file="_flash.jspf" %>
<div class="d-flex justify-content-between"><h4><c:out value="${task.title}"/></h4><div class="d-flex gap-2"><a class="btn btn-outline-primary" href="${ctx}/app/tasks/form?id=${task.id}">Edit</a>
<form method="post" action="${ctx}/app/tasks/delete" onsubmit="return confirm('Hapus tugas?')"><input type="hidden" name="_t" value="${csrf}"><input type="hidden" name="id" value="${task.id}"><button class="btn btn-outline-danger">Hapus</button></form></div></div>
<p class="text-muted"><c:out value="${task.course}"/> · ${task.dl} · ${task.priority} · ${task.status}</p><p><c:out value="${task.description}"/></p>
<div class="row"><div class="col-md-6"><h5>Checklist</h5>
<c:forEach var="s" items="${subs}"><div class="d-flex gap-2 mb-1 align-items-center"><form method="post" action="${ctx}/app/subtasks/toggle"><input type="hidden" name="_t" value="${csrf}"><input type="hidden" name="id" value="${s.id}"><button class="btn btn-sm ${s.is_done?'btn-success':'btn-outline-secondary'}">✓</button></form>
<span class="${s.is_done?'text-decoration-line-through':''}"><c:out value="${s.title}"/></span>
<form method="post" action="${ctx}/app/subtasks/delete"><input type="hidden" name="_t" value="${csrf}"><input type="hidden" name="id" value="${s.id}"><button class="btn btn-sm btn-link text-danger">hapus</button></form></div></c:forEach>
<form method="post" action="${ctx}/app/subtasks/add" class="d-flex gap-2 mt-2"><input type="hidden" name="_t" value="${csrf}"><input type="hidden" name="task_id" value="${task.id}"><input name="title" class="form-control" placeholder="Sub-tugas" required><button class="btn btn-primary">Tambah</button></form></div>
<div class="col-md-6"><h5>Catatan &amp; Link</h5>
<c:forEach var="n" items="${notes}"><div class="d-flex gap-2 mb-1"><span><c:choose><c:when test="${n.type=='link' && fn:startsWith(n.content,'http')}"><a href="<c:out value='${n.content}'/>" target="_blank" rel="noopener"><c:out value="${n.content}"/></a></c:when><c:otherwise><c:out value="${n.content}"/></c:otherwise></c:choose></span>
<form method="post" action="${ctx}/app/notes/delete"><input type="hidden" name="_t" value="${csrf}"><input type="hidden" name="id" value="${n.id}"><button class="btn btn-sm btn-link text-danger">hapus</button></form></div></c:forEach>
<form method="post" action="${ctx}/app/notes/add" class="d-flex gap-2 mt-2"><input type="hidden" name="_t" value="${csrf}"><input type="hidden" name="task_id" value="${task.id}"><select name="type" class="form-select w-auto"><option value="note">Catatan</option><option value="link">Link</option></select><input name="content" class="form-control" required><button class="btn btn-primary">Tambah</button></form></div></div></div>
<%@ include file="_foot.jspf" %>
